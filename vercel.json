{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/promemoria",
      "schedule": "0 8 * * *"
    }
  ],
  "schedules": {
    "promemoria-telegram": {
      "schedule": "5 10-22 * * *",
      "timezone": "Europe/Rome",
      "path": "/api/promemoria-ore",
      "requestMethod": "GET"
    }
  },
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/c/:codice/:struttura",
      "destination": "/checkin.html"
    },
    {
      "source": "/c/:codice",
      "destination": "/checkin.html"
    },
    {
      "source": "/r/:codice",
      "destination": "/ricevuta.html"
    },
    {
      "source": "/apri",
      "destination": "/apri.html"
    },
    {
      "source": "/api/promemoria-ore",
      "destination": "/api/promemoria?ogni3ore=1"
    }
  ]
}
